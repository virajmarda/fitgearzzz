# ==========================================================
# FitGearzzz Frontend - Environment Variables Example
# ==========================================================
# INSTRUCTIONS:
#   1. Copy this file: cp .env.example .env.local
#   2. Fill in your real values in .env.local
#   3. NEVER commit .env or .env.local to git
#   4. Set all these variables in Vercel Dashboard too
#      (Project > Settings > Environment Variables)
# ==========================================================

# --- Shopify Store Configuration ---
# Your Shopify store domain (no https://)
REACT_APP_SHOPIFY_STORE_DOMAIN=your-store.myshopify.com

# Shopify Storefront API Access Token (Public - safe for frontend)
# Get from: Shopify Admin > Settings > Apps and sales channels > Develop apps > API credentials
# ROTATE THIS IMMEDIATELY if previously committed to git history
REACT_APP_SHOPIFY_STOREFRONT_ACCESS_TOKEN=your_storefront_access_token_here

# Shopify Storefront Client Key (same as storefront access token in most setups)
REACT_APP_SHOPIFY_CLIENT_KEY=your_storefront_client_key_here

# --- Shopify Customer Account API (OAuth) ---
# Get from: Shopify Admin > Customer accounts > New customer accounts > API client
# ROTATE THIS IMMEDIATELY if previously committed to git history
SHOPIFY_CLIENT_ID=your-oauth-client-id-here
SHOPIFY_CLIENT_SECRET=your-oauth-client-secret-here

# Redirect URI (must match exactly what you set in Shopify)
SHOPIFY_OAUTH_REDIRECT_URI=https://fitgearzzz.com/auth/callback

# --- Custom Domains ---
REACT_APP_CHECKOUT_DOMAIN=https://checkout.fitgearzzz.com
REACT_APP_ACCOUNT_DOMAIN=https://account.fitgearzzz.com
SHOPIFY_ACCOUNT_DOMAIN=https://account.fitgearzzz.com
SHOPIFY_STORE_DOMAIN=your-store.myshopify.com

# --- Frontend URL ---
FRONTEND_URL=https://fitgearzzz.com

# --- Analytics (Activate after Shopify plan purchase) ---
# Meta Pixel ID - get from Meta Events Manager
# DO NOT hardcode in source code - use this env var only
REACT_APP_META_PIXEL_ID=your_meta_pixel_id_here

# Google Analytics 4 Measurement ID (format: G-XXXXXXXXXX)
# DO NOT hardcode in source code - use this env var only
REACT_APP_GA4_MEASUREMENT_ID=your_ga4_measurement_id_here

# --- Newsletter / ESP (Optional - activate after Shopify plan) ---
# Set REACT_APP_NEWSLETTER_MODE=mock for local dev (no real submissions)
# Set REACT_APP_NEWSLETTER_MODE=shopify-forms after installing Shopify Forms app
REACT_APP_NEWSLETTER_MODE=mock

# --- Backend API ---
REACT_APP_API_URL=http://localhost:8000

# --- PostHog Analytics (Optional) ---
# If using PostHog, set this - leave blank to disable
# REACT_APP_POSTHOG_KEY=your_posthog_key_here
# REACT_APP_POSTHOG_HOST=https://us.i.posthog.com
