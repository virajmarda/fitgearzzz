# ============================================================
# FitGearzzz Frontend - Environment Variables
# ============================================================
# COPY THIS FILE TO .env.local AND FILL IN YOUR REAL VALUES
# NEVER commit .env.local or .env to git!
# ============================================================

# --- Shopify Storefront API ---
# Your Shopify store domain (e.g., yourstore.myshopify.com)
REACT_APP_SHOPIFY_STORE_DOMAIN=your-store.myshopify.com

# Shopify Storefront Access Token (Public token - safe for frontend)
# Get from: Shopify Admin > Settings > Apps and sales channels > Develop apps > API credentials
REACT_APP_SHOPIFY_STOREFRONT_ACCESS_TOKEN=your_storefront_access_token_here

# --- Backend API ---
# URL of your FastAPI backend
REACT_APP_API_URL=http://localhost:8000

# --- Vercel / Production ---
# In Vercel, set these same variables in:
# Project > Settings > Environment Variables

# --- Optional: Analytics / Marketing ---
# Meta Pixel ID (for Meta Ads tracking)
# REACT_APP_META_PIXEL_ID=your_pixel_id

# Google Analytics 4 Measurement ID
# REACT_APP_GA4_MEASUREMENT_ID=G-XXXXXXXXXX

# Klaviyo Public API Key (for email capture)
# REACT_APP_KLAVIYO_PUBLIC_KEY=your_klaviyo_public_key

# ============================================================
# SECURITY CHECKLIST:
# [x] .env.local is in .gitignore
# [x] No real tokens committed to git
# [ ] Shopify storefront token has ONLY storefront read scopes
# [ ] Backend API uses server-side Admin token (never in frontend)
# ============================================================
